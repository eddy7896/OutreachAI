{
  "name": "emailoutreach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:system": "node scripts/system-checks.mjs",
    "check:system:ci": "node scripts/system-checks.mjs --baseline scripts/system-checks.baseline.json",
    "lint:budget": "node scripts/lint-budget.mjs",
    "validate": "node scripts/validate-branch.mjs && npm run -s typecheck && npm run -s test && npm run -s check:system:ci && npm run -s lint:budget",
    "eval": "node scripts/run-evals.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/material-nextjs": "^9.1.1",
    "@mui/x-data-grid": "^9.6.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "3.4.17",
    "firebase": "^12.15.0",
    "firebase-admin": "14.5.0",
    "next": "16.2.9",
    "openai": "^6.44.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "30.1.2",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
